# Accounts (optional). Without both, the game is guest only and the account button doesn't show.
# Clerk Dashboard → API keys → Publishable key.
VITE_CLERK_PUBLISHABLE_KEY=
# The accounts API (server/), e.g. http://localhost:3000 in dev.
VITE_API_URL=
# Analytics and error reports (optional): PostHog → Project settings → Project token (phc_…). Only production
# domains report; to try it locally, run `localStorage.setItem('ps:analytics', 'on')` and reload.
VITE_POSTHOG_KEY=
